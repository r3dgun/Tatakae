@page "/account/artworks"
@inject IAuthSessionStore Auth
@inject IArtworkApiClient ArtworkClient
@inject IFileUploadApiClient Uploader
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Tatakae.Application.Contracts.Embroidery

<SeoHead Title="طرح‌های گلدوزی من | Tatakae" Description="آپلود، ثبت و پیگیری وضعیت تأیید طرح گلدوزی در Tatakae." Path="/account/artworks" Index="false" />
<section class="section account-page" id="artworks">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <span class="eyebrow">embroidery artworks</span>
                <h1 class="title" style="margin-top:14px">طرح‌های گلدوزی من</h1>
                <p class="lead" style="margin-top:12px;max-width:760px">فایل طرح را آپلود کن، ابعاد و تعداد رنگ را بزن و وضعیت بررسی ادمین را همین‌جا ببین.</p>
            </div>
            <a class="ghost" href="/customize/premium-cotton-embroidered-tshirt">رفتن به استودیو</a>
        </div>

        @if (!loaded)
        {
            <div class="loading-state">در حال دریافت طرح‌ها...</div>
        }
        else if (!Auth.IsSignedIn)
        {
            <div class="ink-auth-required">
                <div><span class="eyebrow">login required</span><h2>برای مدیریت طرح‌ها وارد شو</h2><p>طرح‌های آپلودی به حساب کاربری متصل می‌شوند.</p></div>
                <div class="ink-auth-actions"><a class="pill-btn" href="/login?returnUrl=/account/artworks">ورود</a><a class="ghost" href="/register?returnUrl=/account/artworks">ثبت‌نام</a></div>
            </div>
        }
        else
        {
            <div class="admin-grid two artwork-grid">
                <section class="admin-card">
                    <h3>ثبت طرح جدید</h3>
                    <p class="admin-muted">فرمت‌های مجاز: PNG, JPG, WEBP, SVG, PDF, DST, PES تا ۱۵ مگابایت.</p>
                    <EditForm Model="uploadForm" OnValidSubmit="UploadAndSubmitAsync">
                        <RecursiveDataAnnotationsValidator />
                        <ValidationSummary />
                        <label class="file-picker-label">فایل طرح
                            <InputFile OnChange="SelectFile" accept=".png,.jpg,.jpeg,.webp,.svg,.pdf,.dst,.pes" />
                            <span>@(selectedFile?.Name ?? "هنوز فایلی انتخاب نشده است")</span>
                            <ValidationMessage For="() => uploadForm.SelectedFileName" />
                        </label>
                        <div class="admin-form-grid two" style="margin-top:18px">
                            <label>عرض طرح، سانتی‌متر
                                <InputNumber @bind-Value="uploadForm.WidthCm" min="1" max="60" />
                                <ValidationMessage For="() => uploadForm.WidthCm" />
                            </label>
                            <label>ارتفاع طرح، سانتی‌متر
                                <InputNumber @bind-Value="uploadForm.HeightCm" min="1" max="60" />
                                <ValidationMessage For="() => uploadForm.HeightCm" />
                            </label>
                            <label>تعداد رنگ نخ
                                <InputNumber @bind-Value="uploadForm.ThreadColorCount" min="1" max="24" />
                                <ValidationMessage For="() => uploadForm.ThreadColorCount" />
                            </label>
                            <label>یادداشت مشتری
                                <InputTextArea rows="3" maxlength="1200" @bind-Value="uploadForm.CustomerNote" />
                                <ValidationMessage For="() => uploadForm.CustomerNote" />
                            </label>
                        </div>
                        <button class="pill-btn" type="submit" disabled="@uploading">@(uploading ? "در حال ارسال..." : "آپلود و ثبت طرح")</button>
                    </EditForm>
                    @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-message">@message</p> }
                    @if (!string.IsNullOrWhiteSpace(error)) { <p class="form-error">@error</p> }
                </section>

                <section class="admin-card">
                    <h3>راهنمای بررسی طرح</h3>
                    <div class="artwork-status-help">
                        <span>در انتظار بررسی</span><span>تأیید شده</span><span>نیازمند اصلاح</span><span>رد شده</span>
                    </div>
                    <p class="admin-muted">بعد از تأیید طرح، ادمین می‌تواند یادداشت تولید، پیش‌نمایش یا فرمت تولید مثل DST/PES را ثبت کند.</p>
                </section>
            </div>

            <div class="artwork-card-list">
                @if (items.Count == 0)
                {
                    <div class="empty-state">هنوز طرحی ثبت نکردی.</div>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <article class="admin-card artwork-card">
                            <div class="artwork-card-main">
                                @if (item.ContentType.StartsWith("image/"))
                                {
                                    <img src="@item.FileUrl" alt="@item.OriginalFileName" />
                                }
                                else
                                {
                                    <div class="admin-file-icon">@FileLabel(item)</div>
                                }
                                <div>
                                    <b>@item.OriginalFileName</b>
                                    <small>@(item.SizeBytes / 1024) KB · @item.SubmittedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</small>
                                    <p>@item.CustomerNote</p>
                                </div>
                            </div>
                            <div class="artwork-card-meta">
                                <span class="status-pill @StatusClass(item.Status)">@item.StatusLabel</span>
                                <span>@item.WidthCm × @item.HeightCm cm</span>
                                <span>@item.ThreadColorCount رنگ</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.AdminNote) || !string.IsNullOrWhiteSpace(item.RejectionReason))
                            {
                                <div class="artwork-note">
                                    @if (!string.IsNullOrWhiteSpace(item.AdminNote)) { <p><b>یادداشت ادمین:</b> @item.AdminNote</p> }
                                    @if (!string.IsNullOrWhiteSpace(item.RejectionReason)) { <p><b>دلیل:</b> @item.RejectionReason</p> }
                                </div>
                            }
                            <a class="text-link" href="@item.FileUrl" target="_blank">مشاهده فایل</a>
                        </article>
                    }
                }
            </div>
        }
    </div>
</section>

@code {
    private bool loaded;
    private IReadOnlyCollection<EmbroideryArtworkDto> items = Array.Empty<EmbroideryArtworkDto>();
    private ArtworkUploadForm uploadForm = new() { WidthCm = 8, HeightCm = 8, ThreadColorCount = 2 };
    private IBrowserFile? selectedFile;
    private bool uploading;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureLoadedAsync();
        if (Auth.IsSignedIn) items = (await ArtworkClient.MineAsync()).RequireUiData();
        loaded = true;
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        message = null;
        error = null;
        selectedFile = args.File;
        uploadForm.SelectedFileName = selectedFile.Name;

        var extension = System.IO.Path.GetExtension(selectedFile.Name).ToLowerInvariant();
        string[] allowed = [".png", ".jpg", ".jpeg", ".webp", ".svg", ".pdf", ".dst", ".pes"];
        if (!allowed.Contains(extension))
        {
            error = "فرمت فایل مجاز نیست. فقط PNG، JPG، WEBP، SVG، PDF، DST و PES پذیرفته می‌شود.";
            selectedFile = null;
            uploadForm.SelectedFileName = string.Empty;
        }
        else if (selectedFile.Size > 15_000_000)
        {
            error = "حجم فایل نباید بیشتر از ۱۵ مگابایت باشد.";
            selectedFile = null;
            uploadForm.SelectedFileName = string.Empty;
        }
    }

    private async Task UploadAndSubmitAsync()
    {
        if (selectedFile is null)
        {
            error = "فایل طرح را انتخاب کنید.";
            return;
        }

        uploading = true;
        message = null;
        error = null;
        try
        {
            var uploaded = (await Uploader.UploadAsync(selectedFile, "EmbroideryArtwork")).RequireUiData();
            var request = new SubmitEmbroideryArtworkRequest
            {
                MediaAssetId = uploaded.Id,
                WidthCm = uploadForm.WidthCm,
                HeightCm = uploadForm.HeightCm,
                ThreadColorCount = uploadForm.ThreadColorCount,
                CustomerNote = string.IsNullOrWhiteSpace(uploadForm.CustomerNote) ? null : uploadForm.CustomerNote.Trim()
            };
            var result = (await ArtworkClient.SubmitAsync(request)).RequireUiData();
            message = $"طرح {result.OriginalFileName} ثبت شد و در انتظار بررسی است.";
            uploadForm = new ArtworkUploadForm { WidthCm = uploadForm.WidthCm, HeightCm = uploadForm.HeightCm, ThreadColorCount = uploadForm.ThreadColorCount };
            selectedFile = null;
            items = (await ArtworkClient.MineAsync()).RequireUiData();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { uploading = false; }
    }

    private sealed class ArtworkUploadForm : IValidatableObject
    {
        [Required(ErrorMessage = "فایل طرح را انتخاب کنید.")]
        public string SelectedFileName { get; set; } = string.Empty;

        [Range(typeof(decimal), "1", "60", ErrorMessage = "عرض طرح باید بین ۱ تا ۶۰ سانتی‌متر باشد.")]
        public decimal? WidthCm { get; set; }

        [Range(typeof(decimal), "1", "60", ErrorMessage = "ارتفاع طرح باید بین ۱ تا ۶۰ سانتی‌متر باشد.")]
        public decimal? HeightCm { get; set; }

        [Range(1, 24, ErrorMessage = "تعداد رنگ نخ باید بین ۱ تا ۲۴ باشد.")]
        public int? ThreadColorCount { get; set; }

        [StringLength(1200, ErrorMessage = "یادداشت حداکثر ۱۲۰۰ کاراکتر است.")]
        public string? CustomerNote { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (WidthCm.HasValue != HeightCm.HasValue)
            {
                yield return new ValidationResult("عرض و ارتفاع طرح را با هم وارد کنید.", [nameof(WidthCm), nameof(HeightCm)]);
            }
        }
    }

    private static string StatusClass(string status) => status switch
    {
        "Approved" => "ok",
        "Rejected" => "bad",
        "NeedsRevision" => "warn",
        "Archived" => "muted",
        _ => "pending"
    };

    private static string FileLabel(EmbroideryArtworkDto item) => System.IO.Path.GetExtension(item.OriginalFileName).Trim('.').ToUpperInvariant() switch
    {
        "DST" => "DST",
        "PES" => "PES",
        "PDF" => "PDF",
        _ => "FILE"
    };
}
