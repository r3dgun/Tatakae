@page "/account"
@inject IAuthSessionStore Auth
@inject IAccountApiClient AccountApi
@inject ICartState Cart
@inject NavigationManager Navigation

<SeoHead Title="حساب کاربری Tatakae" Description="داشبورد حساب کاربری فروشگاه گلدوزی Tatakae، سفارش‌ها، سبد خرید و اطلاعات مشتری." Path="/account" Index="false" />
<section class="section account-page" id="account">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <span class="eyebrow">customer account</span>
                <h1 class="title" style="margin-top:14px">حساب کاربری</h1>
                <p class="lead" style="margin-top:12px;max-width:760px">اطلاعات حساب، وضعیت ورود، سبد خرید متصل به حساب و خلاصه سفارش‌ها.</p>
            </div>
            <div class="account-head-actions"><a class="ghost" href="/account/orders">مشاهده سفارش‌ها</a><a class="ghost" href="/account/addresses">آدرس‌ها</a><a class="ghost" href="/account/wishlist">علاقه‌مندی‌ها</a><a class="ghost" href="/account/artworks">طرح‌ها</a><a class="ghost" href="/account/notifications">اعلان‌ها</a></div>
        </div>

        @if (!loaded)
        {
            <div class="ink-state"><h2>در حال دریافت حساب...</h2><p>چند لحظه صبر کن.</p></div>
        }
        else if (!Auth.IsSignedIn)
        {
            <div class="panel pad reveal account-empty">
                <h2>وارد حساب نشده‌ای</h2>
                <p class="lead">برای پیگیری سفارش‌ها، ذخیره سبد خرید و ادامه Checkout وارد شو یا حساب بساز.</p>
                <div class="auth-switch"><a class="pill-btn" href="/login">ورود</a><a class="ghost" href="/register">ثبت‌نام</a></div>
            </div>
        }
        else
        {
            <div class="account-hero-card">
                <div>
                    <span class="eyebrow">signed in</span>
                    <h2>@Session.FullName</h2>
                    <p>@Session.Mobile @(!string.IsNullOrWhiteSpace(Session.Email) ? $"· {Session.Email}" : string.Empty)</p>
                </div>
                <div class="account-hero-actions">
                    <a class="ghost" href="/checkout">رفتن به Checkout</a>
                    <button class="ghost" @onclick="RefreshAccount">تازه‌سازی</button>
                    <button class="ghost danger" @onclick="SignOut">خروج</button>
                </div>
            </div>

            <div class="account-dashboard-grid">
                <article class="account-panel account-profile-panel">
                    <span class="eyebrow">profile details</span>
                    <h3>جزئیات حساب</h3>
                    <dl class="account-detail-list">
                        <div><dt>نام کامل</dt><dd>@Session.FullName</dd></div>
                        <div><dt>موبایل</dt><dd>@Session.Mobile</dd></div>
                        <div><dt>ایمیل</dt><dd>@(string.IsNullOrWhiteSpace(Session.Email) ? "ثبت نشده" : Session.Email)</dd></div>
                        <div><dt>شناسه مشتری</dt><dd>@(Session.CustomerId == Guid.Empty ? "در حال اتصال" : Session.CustomerId)</dd></div>
                        <div><dt>ماندن در سیستم</dt><dd>@(Session.RememberMe ? "فعال" : "فقط همین نشست")</dd></div>
                        <div><dt>اعتبار ورود</dt><dd>@Session.ExpiresAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd></div>
                    </dl>
                </article>

                <article class="account-panel">
                    <span class="eyebrow">orders</span>
                    <h3>وضعیت خرید</h3>
                    @if (profile is null)
                    {
                        <p class="lead">هنوز پروفایل فروشگاهی برای این کاربر ثبت نشده یا سفارشی ثبت نکرده است.</p>
                    }
                    else
                    {
                        <div class="account-stat-grid">
                            <div><b>@profile.OrderCount</b><span>سفارش</span></div>
                            <div><b>@Currency.Format(profile.LifetimeValue)</b><span>ارزش خرید</span></div>
                            <div><b>@profile.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</b><span>تاریخ عضویت</span></div>
                        </div>
                    }
                    <a class="text-link account-link" href="/account/orders">مشاهده سفارش‌ها <span>↗</span></a>
                </article>

                <article class="account-panel">
                    <span class="eyebrow">address book</span>
                    <h3>آدرس‌های ارسال</h3>
                    <p class="lead">آدرس پیش‌فرض در Checkout خودکار انتخاب می‌شود و برای سفارش‌های بعدی دوباره لازم نیست تایپ شود.</p>
                    <a class="text-link account-link" href="/account/addresses">مدیریت آدرس‌ها <span>↗</span></a>
                </article>


                <article class="account-panel">
                    <span class="eyebrow">wishlist</span>
                    <h3>علاقه‌مندی‌ها و پیشنهادها</h3>
                    <p class="lead">محصول‌های ذخیره‌شده، اخیراً دیده‌شده و پیشنهادهای مرتبط برای خرید بعدی.</p>
                    <a class="text-link account-link" href="/account/wishlist">مشاهده علاقه‌مندی‌ها <span>↗</span></a>
                </article>

                <article class="account-panel">
                    <span class="eyebrow">cart sync</span>
                    <h3>سبد خرید متصل</h3>
                    <div class="account-stat-grid two">
                        <div><b>@Cart.Count</b><span>آیتم</span></div>
                        <div><b>@Currency.Format(Cart.Subtotal)</b><span>جمع موقت</span></div>
                    </div>
                    <p class="lead">@CartSyncText</p>
                    <div class="account-mini-lines">
                        @foreach (var item in Cart.Items.Take(3))
                        {
                            <div><img src="@item.ProductImageUrl" alt="@item.ProductName" /><span>@item.ProductName<br /><small>@item.ColorName · @item.Size · @item.Quantity عدد</small></span><b>@Currency.Format(item.LineTotal)</b></div>
                        }
                    </div>
                    <a class="text-link account-link" href="/checkout">ادامه ثبت سفارش <span>↗</span></a>
                </article>


                <article class="account-panel">
                    <span class="eyebrow">notifications</span>
                    <h3>اعلان‌ها و پیگیری‌ها</h3>
                    <p class="lead">تغییر وضعیت سفارش، پرداخت، کد رهگیری و پیام‌های مهم فروشگاه اینجا جمع می‌شود.</p>
                    <a class="text-link account-link" href="/account/notifications">مشاهده اعلان‌ها <span>↗</span></a>
                </article>

                <article class="account-panel">
                    <span class="eyebrow">access</span>
                    <h3>نقش‌ها و دسترسی‌ها</h3>
                    <div class="account-chip-list">
                        @foreach (var role in Session.Roles ?? Array.Empty<string>())
                        {
                            <span>@role</span>
                        }
                        @if ((Session.Roles?.Count ?? 0) == 0)
                        {
                            <span>Customer</span>
                        }
                    </div>
                    <p class="lead">@((Session.Permissions?.Count ?? 0) > 0 ? $"{Session.Permissions!.Count} دسترسی برای این حساب فعال است." : "این حساب دسترسی مدیریتی ندارد.")</p>
                    @if (Session.Permissions?.Contains(PermissionNames.AdminDashboardView) == true)
                    {
                        <a class="text-link account-link" href="/admin">ورود به پنل مدیریت <span>↗</span></a>
                    }
                </article>
            </div>
        }
    </div>
</section>

@code {
    private AccountProfileDto? profile;
    private bool loaded;
    private AccountSessionDto Session => Auth.Current!;
    private string CartSyncText => Cart.IsAttachedToAccount
        ? $"این سبد خرید به حساب {Cart.OwnerMobile} متصل شده و بعد از ورود دوباره در همین مرورگر باقی می‌ماند."
        : "این سبد هنوز مهمان است؛ بعد از ورود به حساب منتقل می‌شود.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountAsync();
    }

    private async Task LoadAccountAsync()
    {
        await Auth.EnsureLoadedAsync();
        await Cart.EnsureLoadedAsync(Auth.Current);
        if (Auth.IsSignedIn)
        {
            var fresh = (await AccountApi.MeAsync()).OptionalData();
            if (fresh is not null)
            {
                await Auth.SignInAsync(fresh);
                await Cart.MergeGuestCartIntoAccountAsync(fresh);
            }
            profile = (await AccountApi.ProfileAsync(Auth.Current!.Mobile)).OptionalData();
        }
        loaded = true;
    }

    private async Task RefreshAccount()
    {
        loaded = false;
        await LoadAccountAsync();
    }

    private async Task SignOut()
    {
        _ = await AccountApi.LogoutAsync();
        await Cart.DetachToGuestAsync();
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/");
    }
}
