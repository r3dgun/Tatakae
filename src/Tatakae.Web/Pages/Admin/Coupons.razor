@page "/admin/coupons"
@layout AdminLayout
@attribute [Authorize(Policy = PermissionNames.AdminCouponsView)]
@inject IAdminApiClient Admin

<PageTitle>کدهای تخفیف | Tatakae</PageTitle>
<section class="admin-page"><div class="admin-head"><div><p class="admin-kicker">PROMOTIONS</p><h1>کدهای تخفیف</h1><p>برای کمپین‌های فروش و سفارش‌های گلدوزی، محدودیت مبلغ و تعداد استفاده تعریف کنید.</p></div></div><div class="admin-two-column"><section class="admin-card"><h2>@(editingId is null?"کد جدید":"ویرایش کد")</h2><EditForm Model="form" OnValidSubmit="Save"><RecursiveDataAnnotationsValidator /><ValidationSummary/><div class="editor-section"><label>کد<InputText dir="ltr" @bind-Value="form.Code"/></label><label>نوع<select @bind="form.Type"><option>Percentage</option><option>FixedAmount</option></select></label><label>مقدار<InputNumber @bind-Value="form.Value"/></label><label>حداقل مبلغ سفارش<InputNumber @bind-Value="form.MinimumOrderAmount"/></label><label>سقف استفاده<InputNumber @bind-Value="form.UsageLimit"/></label><label class="checkbox-label"><InputCheckbox @bind-Value="form.IsActive"/> فعال</label><button class="admin-primary" disabled="@saving">@(saving?"در حال ذخیره...":"ذخیره کد")</button><button type="button" class="admin-secondary" @onclick="Reset">پاک کردن فرم</button>@if(!string.IsNullOrWhiteSpace(message)){<p class="form-message">@message</p>}</div></EditForm></section><section class="admin-card"><h2>کدهای فعال و گذشته</h2><div class="coupon-list">@foreach(var coupon in coupons){<article><div><b dir="ltr">@coupon.Code</b><small>@(coupon.Type=="Percentage"?$"{coupon.Value:N0}% تخفیف":$"{Currency.Format(coupon.Value)} تخفیف")</small><small>@coupon.UsageCount استفاده · حداقل @Currency.Format(coupon.MinimumOrderAmount??0)</small></div><span class="status-badge @(coupon.IsActive?"success":"danger")">@(coupon.IsActive?"فعال":"غیرفعال")</span><div class="table-actions"><button @onclick="()=>Edit(coupon)">ویرایش</button><button class="danger" @onclick="()=>Delete(coupon)">حذف</button></div></article>}</div></section></div></section>
@code{private IReadOnlyCollection<CouponDto> coupons=Array.Empty<CouponDto>();private AdminCouponRequest form=new(){StartsAt=DateTimeOffset.UtcNow,Type="Percentage",Value=10};private Guid? editingId;private bool saving;private string? message;protected override async Task OnInitializedAsync()=>await Load();private async Task Load()=>coupons=(await Admin.CouponsAsync()).RequireUiData();private void Reset(){editingId=null;form=new AdminCouponRequest{StartsAt=DateTimeOffset.UtcNow,Type="Percentage",Value=10};}private void Edit(CouponDto c){editingId=c.Id;form=new AdminCouponRequest{Code=c.Code,Type=c.Type,Value=c.Value,StartsAt=c.StartsAt,EndsAt=c.EndsAt,UsageLimit=c.UsageLimit,MinimumOrderAmount=c.MinimumOrderAmount,IsActive=c.IsActive};}private async Task Save(){saving=true;message=null;try{if(editingId is null)(await Admin.CreateCouponAsync(form)).RequireUiData();else (await Admin.UpdateCouponAsync(editingId.Value,form)).RequireUiData();await Load();Reset();message="کد تخفیف ذخیره شد.";}catch(Exception ex){message=ex.Message;}finally{saving=false;}}private async Task Delete(CouponDto c){(await Admin.DeleteCouponAsync(c.Id)).EnsureUiSuccess();await Load();}}
