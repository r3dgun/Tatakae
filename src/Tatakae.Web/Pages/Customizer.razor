@page "/customize/{Slug}"
@inject IStoreApiClient Store
@inject ICheckoutApiClient Checkout
@inject IFileUploadApiClient Uploader
@inject IArtworkApiClient Artworks
@inject IAuthSessionStore Auth
@inject ICartState Cart
@inject NavigationManager Navigation

<SeoHead Title="@StudioSeoTitle" Description="استودیوی شخصی‌سازی و ثبت طرح گلدوزی برای محصول انتخاب‌شده." Path="@($"/customize/{SeoSlug.Normalize(Slug)}")" Index="false" Follow="false" />

@if (product is null && loading)
{
    <section class="studio-editorial panel"><div class="ink-state">در حال آماده‌سازی استودیوی گلدوزی...</div></section>
}
else if (product is null)
{
    <section class="studio-editorial panel"><div class="ink-state"><h1>لباس موردنظر پیدا نشد</h1><a href="/shop">بازگشت به فروشگاه</a></div></section>
}
else
{
    <section class="studio-editorial panel" id="studio" data-accent="paper">
        <header class="studio-head">
            <div>
                <p class="eyebrow">EMBROIDERY STUDIO / CUSTOM ORDER</p>
                <h1 class="studio-title">استودیو گلدوزی</h1>
                <p class="studio-lead">لباس، سایز و رنگ را انتخاب کن؛ سپس متن، طرح آماده یا فایل خودت را روی لباس جابه‌جا کن. این ساختار برای سفارش واقعی گلدوزی طراحی شده و از فیلتر فروشگاه جداست.</p>
                <a class="text-link" href="@($"/product/{product.Slug}")">بازگشت به صفحه محصول <span>↙</span></a>
            </div>
            <aside class="studio-total">
                <span>مجموع فعلی</span>
                <strong>@Currency.Format((selectedVariant?.EffectivePrice ?? 0) + (quote?.TotalEmbroideryPrice ?? 0))</strong>
                <small>@product.Name</small>
            </aside>
        </header>

        <div class="studio-layout">
            <aside class="studio-panel">
                <h2>تنظیمات سفارش</h2>
                <div class="studio-field">
                    <label>نوع لباس</label>
                    <select class="studio-select" value="@customization.GarmentType" @onchange="OnGarmentTypeChanged">
                        <option value="TShirt">تی‌شرت</option>
                        <option value="Hoodie">هودی</option>
                        <option value="Sweatshirt">دورس / سویشرت</option>
                    </select>
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">سایز</span>
                    <div class="studio-chips">
                        @foreach (var size in Sizes)
                        {
                            <button class="studio-chip @(customization.GarmentSize == size ? "active" : null)" @onclick="() => SelectSize(size)">@size</button>
                        }
                    </div>
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">رنگ لباس</span>
                    <div class="studio-swatches">
                        @foreach (var variant in ColorVariants)
                        {
                            <button title="@variant.ColorName" class="studio-swatch @(selectedVariant?.ColorHex == variant.ColorHex ? "active" : null)" style="background:@variant.ColorHex" @onclick="() => SelectColor(variant)"></button>
                        }
                    </div>
                    <input type="color" value="@customization.GarmentColorHex" @oninput="OnCustomColorChanged" style="width:100%;height:40px;margin-top:10px;border:1px solid var(--ink);background:transparent" />
                </div>
                <div class="studio-field">
                    <label>آپلود طرح گلدوزی</label>
                    <label class="studio-upload">آپلود PNG / JPG / SVG<InputFile OnChange="UploadAsync" accept=".png,.jpg,.jpeg,.webp,.svg" /></label>
                </div>
                <div class="studio-field">
                    <label>متن گلدوزی</label>
                    <input class="studio-input" maxlength="30" placeholder="مثلاً TATAKAE" value="@customization.Text" @oninput="OnTextChanged" />
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">طرح آماده</span>
                    <div class="studio-chips">
                        <button class="studio-chip @(customization.MotifKey == "dragon" && customization.DesignSource == "Motif" ? "active" : null)" @onclick="SelectDragon">اژدها</button>
                        <button class="studio-chip @(customization.MotifKey == "sword" && customization.DesignSource == "Motif" ? "active" : null)" @onclick="SelectSword">شمشیر</button>
                        <button class="studio-chip @(customization.MotifKey == "cloud" && customization.DesignSource == "Motif" ? "active" : null)" @onclick="SelectCloud">ابر</button>
                    </div>
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">محل گلدوزی</span>
                    <div class="studio-chips">
                        @foreach (var placement in product.EmbroideryPolicy.AllowedPlacements)
                        {
                            <button class="studio-chip @(customization.Placement == placement ? "active" : null)" @onclick="async () => { customization.Placement = placement; await RefreshQuoteAsync(); }">@PlacementLabel(placement)</button>
                        }
                    </div>
                </div>
            </aside>

            <section class="studio-canvas-card">
                <div class="preview-stage" style="--cloth:@customization.GarmentColorHex" @onpointermove="OnPointerMove" @onpointerup="EndDrag" @onpointerleave="EndDrag">
                    <div class="safe-area"></div>
                    <div class="garment">@((MarkupString)GarmentSvg(customization.GarmentType))</div>
                    <div class="design-layer" style="@DesignStyle" @onpointerdown="BeginDrag">
                        @if (customization.DesignSource == "Text" && !string.IsNullOrWhiteSpace(customization.Text))
                        {
                            <div class="studio-text-design" style="color:@selectedColors.FirstOrDefault()">@customization.Text</div>
                        }
                        else
                        {
                            <img src="@DesignImage" alt="طرح گلدوزی" />
                        }
                    </div>
                </div>
            </section>

            <aside class="studio-panel studio-summary">
                <h2>کنترل طرح</h2>
                <div class="studio-field">
                    <div class="range-row"><label>اندازه</label><output>@customization.ScalePercent%</output></div>
                    <input type="range" min="35" max="210" value="@customization.ScalePercent" @oninput="OnScaleChanged" />
                </div>
                <div class="studio-field">
                    <div class="range-row"><label>چرخش</label><output>@customization.RotationDegrees°</output></div>
                    <input type="range" min="-180" max="180" value="@customization.RotationDegrees" @oninput="OnRotationChanged" />
                </div>
                <div class="studio-field">
                    <label>شفافیت طرح</label>
                    <input type="range" min="35" max="100" value="@customization.OpacityPercent" @oninput="OnOpacityChanged" />
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">جابه‌جایی دقیق</span>
                    <div class="move-grid">
                        <span></span><button @onclick="MoveUp">↑</button><span></span>
                        <button @onclick="MoveRight">→</button><button @onclick="MoveDown">↓</button><button @onclick="MoveLeft">←</button>
                    </div>
                </div>
                <div class="quick-actions">
                    <button @onclick="CenterDesign">مرکز</button>
                    <button @onclick="ResetDesign">ریست</button>
                    <button @onclick="RotateLeft">↶ ۱۵°</button>
                    <button @onclick="RotateRight">۱۵° ↷</button>
                </div>
                <div class="studio-field">
                    <label>ابعاد گلدوزی</label>
                    <div class="dimension-grid">
                        <input class="studio-input" type="number" min="1" max="@product.EmbroideryPolicy.MaxWidthCm" value="@customization.WidthCm" @oninput="OnWidthChanged" />
                        <input class="studio-input" type="number" min="1" max="@product.EmbroideryPolicy.MaxHeightCm" value="@customization.HeightCm" @oninput="OnHeightChanged" />
                    </div>
                </div>
                <div class="studio-field">
                    <span class="studio-field-title">رنگ نخ</span>
                    <p style="font-size:12px;line-height:1.8;color:var(--muted)">حداکثر @product.EmbroideryPolicy.MaxThreadColors رنگ. @selectedColors.Count رنگ انتخاب شده است.</p>
                    <div class="thread-colors">
                        @foreach (var color in product.EmbroideryPolicy.AllowedThreadColors)
                        {
                            <button aria-label="@color" class="@(selectedColors.Contains(color) ? "active" : null)" style="background:@color" @onclick="async () => { ToggleColor(color); await RefreshQuoteAsync(); }"></button>
                        }
                    </div>
                </div>
                <div class="sum-row"><span>نوع لباس</span><b>@GarmentLabel(customization.GarmentType)</b></div>
                <div class="sum-row"><span>سایز</span><b>@customization.GarmentSize</b></div>
                <div class="sum-row"><span>نوع طرح</span><b>@DesignLabel</b></div>
                <div class="sum-row"><span>هزینه گلدوزی</span><b>@Currency.Format(quote?.TotalEmbroideryPrice ?? 0)</b></div>
                @if (quote is not null && quote.Warnings.Count > 0)
                {
                    <div class="studio-field"><b>هشدارها</b>@foreach (var warning in quote.Warnings) { <p>@warning</p> }</div>
                }
                <button class="studio-add-to-cart" disabled="@(quote?.IsValid != true || selectedVariant is null)" @onclick="AddToCart">افزودن به سبد خرید</button>
                @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-message">@message</p> }
            </aside>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private string StudioSeoTitle => product is null ? "استودیو گلدوزی | Tatakae" : $"استودیو گلدوزی {product.Name} | Tatakae";
    private ProductDetailDto? product;
    private ProductVariantDto? selectedVariant;
    private bool loading = true;
    private string? artworkDataUrl;
    private readonly List<string> selectedColors = ["#FFFFFF"];
    private EmbroideryCustomizationRequest customization = new() { Placement = "CenterChest", MotifKey = "dragon", DesignSource = "Motif" };
    private EmbroideryQuoteDto? quote;
    private string? message;
    private bool dragging;
    private double dragStartX;
    private double dragStartY;
    private int baseX;
    private int baseY;

    private IEnumerable<string> Sizes => product is null
        ? Enumerable.Empty<string>()
        : product.Variants.Where(x => x.IsActive).Select(x => x.Size).Distinct().OrderBy(SizeRank);
    private IEnumerable<ProductVariantDto> ColorVariants => product is null
        ? Enumerable.Empty<ProductVariantDto>()
        : product.Variants.Where(x => x.IsActive && x.Size == customization.GarmentSize).GroupBy(x => x.ColorHex).Select(x => x.First());
    private string DesignImage => customization.DesignSource == "Upload" ? artworkDataUrl ?? MotifSvg("dragon") : MotifSvg(customization.MotifKey ?? "dragon");
    private string DesignLabel => customization.DesignSource switch { "Upload" => "آپلودی", "Text" => "متنی", _ => (customization.MotifKey == "sword" ? "شمشیر" : customization.MotifKey == "cloud" ? "ابر" : "اژدها") };
    private string DesignStyle => $"left:calc(50% + {customization.PositionX}px);top:calc(46% + {customization.PositionY}px);transform:translate(-50%,-50%) rotate({customization.RotationDegrees}deg) scale({customization.ScalePercent / 100m:0.##});opacity:{customization.OpacityPercent / 100m:0.##}";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        product = (await Store.GetProductAsync(Slug)).OptionalData();
        if (product is not null)
        {
            var requested = GetQuery("variant");
            selectedVariant = Guid.TryParse(requested, out var id) ? product.Variants.FirstOrDefault(x => x.Id == id && x.IsInStock) : null;
            selectedVariant ??= product.Variants.FirstOrDefault(x => x.IsInStock);
            SyncProduct(true);
            await RefreshQuoteAsync();
        }
        loading = false;
    }

    private void SyncProduct(bool resetDesign = false)
    {
        if (product is null || selectedVariant is null) return;
        customization.ProductId = product.Id;
        customization.VariantId = selectedVariant.Id;
        customization.GarmentType = product.ApparelCategory switch { "Hoodie" => "Hoodie", "Sweatshirt" => "Sweatshirt", _ => "TShirt" };
        customization.GarmentSize = selectedVariant.Size;
        customization.GarmentColorHex = selectedVariant.ColorHex;
        customization.Placement = product.EmbroideryPolicy.AllowedPlacements.Contains(customization.Placement) ? customization.Placement : (product.EmbroideryPolicy.AllowedPlacements.Contains("CenterChest") ? "CenterChest" : product.EmbroideryPolicy.AllowedPlacements.FirstOrDefault() ?? "LeftChest");
        customization.WidthCm = Math.Min(9m, product.EmbroideryPolicy.MaxWidthCm);
        customization.HeightCm = Math.Min(9m, product.EmbroideryPolicy.MaxHeightCm);
        customization.ThreadColorHexes = selectedColors.ToList();
        customization.ThreadColorCount = selectedColors.Count;
        if (resetDesign) ResetDesignValues();
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        string[] allowed = [".png", ".jpg", ".jpeg", ".webp", ".svg"];
        if (!allowed.Contains(extension))
        {
            message = "فرمت طرح مجاز نیست. فقط PNG، JPG، WEBP و SVG پذیرفته می‌شود.";
            return;
        }
        if (file.Size <= 0 || file.Size > 15_000_000)
        {
            message = "حجم فایل طرح باید بیشتر از صفر و حداکثر ۱۵ مگابایت باشد.";
            return;
        }

        try
        {
            var result = (await Uploader.UploadAsync(file, "EmbroideryArtwork")).RequireUiData();
            artworkDataUrl = result.Url;
            customization.ArtworkFileUrl = result.Url;
            customization.ArtworkFileName = result.FileName;
            customization.DesignSource = "Upload";
            customization.MotifKey = "custom";
            customization.Text = null;

            await Auth.EnsureLoadedAsync();
            if (Auth.IsSignedIn)
            {
                (await Artworks.SubmitAsync(new SubmitEmbroideryArtworkRequest
                {
                    MediaAssetId = result.Id,
                    ProductId = customization.ProductId,
                    WidthCm = customization.WidthCm,
                    HeightCm = customization.HeightCm,
                    ThreadColorCount = customization.ThreadColorCount,
                    CustomerNote = customization.Note
                })).RequireUiData();
                message = "فایل طرح آپلود شد و برای بررسی ادمین ثبت شد.";
            }
            else
            {
                message = "فایل طرح آپلود شد. برای پیگیری وضعیت تأیید، وارد حساب کاربری شو.";
            }
            await RefreshQuoteAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task RefreshQuoteAsync()
    {
        if (product is null || selectedVariant is null) return;
        customization.ProductId = product.Id;
        customization.VariantId = selectedVariant.Id;
        customization.ThreadColorHexes = selectedColors.ToList();
        customization.ThreadColorCount = selectedColors.Count;
        customization.GarmentSize = selectedVariant.Size;
        try { quote = (await Checkout.QuoteAsync(customization)).RequireUiData(); }
        catch (Exception ex) { quote = new EmbroideryQuoteDto(0, 0, 0, 0, "", false, [ex.Message]); }
    }

    private async Task SelectSize(string size)
    {
        customization.GarmentSize = size;
        selectedVariant = product?.Variants.FirstOrDefault(x => x.Size == size && x.ColorHex == customization.GarmentColorHex && x.IsInStock)
            ?? product?.Variants.FirstOrDefault(x => x.Size == size && x.IsInStock)
            ?? selectedVariant;
        if (selectedVariant is not null) customization.GarmentColorHex = selectedVariant.ColorHex;
        await RefreshQuoteAsync();
    }

    private async Task SelectColor(ProductVariantDto variant)
    {
        selectedVariant = variant;
        customization.GarmentSize = variant.Size;
        customization.GarmentColorHex = variant.ColorHex;
        await RefreshQuoteAsync();
    }

    private async Task OnGarmentTypeChanged(ChangeEventArgs e)
    {
        customization.GarmentType = Convert.ToString(e.Value) ?? "TShirt";
        await RefreshQuoteAsync();
    }

    private async Task OnCustomColorChanged(ChangeEventArgs e)
    {
        customization.GarmentColorHex = Convert.ToString(e.Value) ?? customization.GarmentColorHex;
        await RefreshQuoteAsync();
    }

    private async Task OnTextChanged(ChangeEventArgs e)
    {
        customization.Text = Convert.ToString(e.Value);
        if (!string.IsNullOrWhiteSpace(customization.Text))
        {
            customization.DesignSource = "Text";
            customization.MotifKey = null;
            customization.ArtworkFileUrl = null;
        }
        await RefreshQuoteAsync();
    }

    private Task SelectDragon() => SelectMotif("dragon");
    private Task SelectSword() => SelectMotif("sword");
    private Task SelectCloud() => SelectMotif("cloud");

    private async Task SelectMotif(string key)
    {
        customization.DesignSource = "Motif";
        customization.MotifKey = key;
        customization.Text = null;
        customization.ArtworkFileUrl = null;
        customization.ArtworkFileName = null;
        await RefreshQuoteAsync();
    }

    private async Task OnScaleChanged(ChangeEventArgs e) { customization.ScalePercent = ToInt(e.Value, 100); await RefreshQuoteAsync(); }
    private async Task OnRotationChanged(ChangeEventArgs e) { customization.RotationDegrees = ToInt(e.Value, 0); await RefreshQuoteAsync(); }
    private async Task OnOpacityChanged(ChangeEventArgs e) { customization.OpacityPercent = ToInt(e.Value, 100); await RefreshQuoteAsync(); }
    private async Task OnWidthChanged(ChangeEventArgs e)
    {
        var max = product?.EmbroideryPolicy.MaxWidthCm ?? 40m;
        customization.WidthCm = Math.Clamp(ToDecimal(e.Value, customization.WidthCm), 1m, max);
        await RefreshQuoteAsync();
    }

    private async Task OnHeightChanged(ChangeEventArgs e)
    {
        var max = product?.EmbroideryPolicy.MaxHeightCm ?? 40m;
        customization.HeightCm = Math.Clamp(ToDecimal(e.Value, customization.HeightCm), 1m, max);
        await RefreshQuoteAsync();
    }

    private void ToggleColor(string color)
    {
        if (selectedColors.Contains(color)) { if (selectedColors.Count > 1) selectedColors.Remove(color); }
        else if (product is not null && selectedColors.Count < product.EmbroideryPolicy.MaxThreadColors) selectedColors.Add(color);
    }

    private void BeginDrag(PointerEventArgs e)
    {
        dragging = true;
        dragStartX = e.ClientX;
        dragStartY = e.ClientY;
        baseX = customization.PositionX;
        baseY = customization.PositionY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!dragging) return;
        customization.PositionX = Clamp(baseX + (int)Math.Round(e.ClientX - dragStartX), -260, 260);
        customization.PositionY = Clamp(baseY + (int)Math.Round(e.ClientY - dragStartY), -260, 260);
    }

    private void EndDrag() => dragging = false;
    private void MoveUp() => Move("up");
    private void MoveRight() => Move("right");
    private void MoveDown() => Move("down");
    private void MoveLeft() => Move("left");

    private void Move(string direction)
    {
        if (direction == "up") customization.PositionY -= 8;
        if (direction == "down") customization.PositionY += 8;
        if (direction == "left") customization.PositionX -= 8;
        if (direction == "right") customization.PositionX += 8;
        customization.PositionX = Clamp(customization.PositionX, -260, 260);
        customization.PositionY = Clamp(customization.PositionY, -260, 260);
    }
    private void CenterDesign() { customization.PositionX = 0; customization.PositionY = 0; }
    private void ResetDesign() { ResetDesignValues(); }
    private void RotateLeft() => customization.RotationDegrees = Clamp(customization.RotationDegrees - 15, -180, 180);
    private void RotateRight() => customization.RotationDegrees = Clamp(customization.RotationDegrees + 15, -180, 180);
    private void ResetDesignValues() { customization.PositionX = 0; customization.PositionY = 0; customization.ScalePercent = 100; customization.RotationDegrees = 0; customization.OpacityPercent = 100; }

    private void AddToCart()
    {
        if (product is null || selectedVariant is null)
        {
            message = "ابتدا محصول، سایز و رنگ را انتخاب کنید.";
            return;
        }

        customization.ProductId = product.Id;
        customization.VariantId = selectedVariant.Id;
        customization.ThreadColorHexes = selectedColors.ToList();
        customization.ThreadColorCount = selectedColors.Count;
        var validation = ObjectGraphValidator.Validate(customization);
        if (validation.Count > 0)
        {
            message = string.Join(" ", validation.Select(x => x.ErrorMessage).Distinct());
            return;
        }
        if (quote?.IsValid != true)
        {
            message = quote is null ? "اعتبارسنجی قیمت انجام نشده است." : string.Join(" ", quote.Errors);
            return;
        }

        Cart.Add(product, selectedVariant, customization, quote.TotalEmbroideryPrice);
        message = "سفارش گلدوزی به سبد اضافه شد.";
    }

    private string? GetQuery(string key)
    {
        var pairs = new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        return pairs.Select(x => x.Split('=', 2)).Where(x => x.Length == 2 && x[0] == key).Select(x => Uri.UnescapeDataString(x[1])).FirstOrDefault();
    }

    private static int ToInt(object? value, int fallback) => int.TryParse(Convert.ToString(value), out var result) ? result : fallback;
    private static decimal ToDecimal(object? value, decimal fallback) => decimal.TryParse(Convert.ToString(value), out var result) ? result : fallback;
    private static int Clamp(int value, int min, int max) => Math.Max(min, Math.Min(max, value));
    private static int SizeRank(string value) => value switch { "XS" => 0, "S" => 1, "M" => 2, "L" => 3, "XL" => 4, "2XL" => 5, "3XL" => 6, _ => 99 };
    private static string GarmentLabel(string value) => value switch { "Hoodie" => "هودی", "Sweatshirt" or "Crewneck" => "دورس / سویشرت", _ => "تی‌شرت" };
    private static string PlacementLabel(string placement) => placement switch { "LeftChest" => "سینه چپ", "CenterChest" => "وسط سینه", "RightChest" => "سینه راست", "BackNeck" => "پشت یقه", "LeftSleeve" => "آستین چپ", "RightSleeve" => "آستین راست", _ => placement };

    private static string MotifSvg(string key) => key switch
    {
