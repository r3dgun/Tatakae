@inject NavigationManager Navigation
<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="robots" content="@Robots" />
    <meta http-equiv="content-language" content="fa-IR" />
    <link rel="canonical" href="@Canonical" />
    <link rel="alternate" type="text/markdown" href="@LlmsUrl" title="Tatakae AI site guide" />
    <link rel="alternate" type="application/json" href="@AiCatalogUrl" title="Tatakae public product catalog" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="Tatakae" />
    <meta property="og:type" content="@Type" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Canonical" />
    @if (!string.IsNullOrWhiteSpace(Image))
    {
        <meta property="og:image" content="@AbsoluteImage" />
        <meta property="og:image:alt" content="@Title" />
    }
    <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(Image) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    @if (!string.IsNullOrWhiteSpace(Image))
    {
        <meta name="twitter:image" content="@AbsoluteImage" />
        <meta name="twitter:image:alt" content="@Title" />
    }
    @if (!string.IsNullOrWhiteSpace(JsonLd))
    {
        <script type="application/ld+json">@((MarkupString)JsonLd)</script>
    }
</HeadContent>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string Path { get; set; } = "/";
    [Parameter] public string Type { get; set; } = "website";
    [Parameter] public string? Image { get; set; }
    [Parameter] public string? JsonLd { get; set; }
    [Parameter] public bool Index { get; set; } = true;
    [Parameter] public bool Follow { get; set; } = true;
    private string Canonical => Navigation.ToAbsoluteUri(SeoSlug.NormalizeCanonicalPath(Path, "/")).ToString();
    private string LlmsUrl => Navigation.ToAbsoluteUri("/llms.txt").ToString();
    private string AiCatalogUrl => Navigation.ToAbsoluteUri("/ai/catalog.json").ToString();
    private string AbsoluteImage => string.IsNullOrWhiteSpace(Image) ? string.Empty : (Uri.TryCreate(Image, UriKind.Absolute, out var uri) ? uri.ToString() : Navigation.ToAbsoluteUri(Image).ToString());
    private string Robots => $"{(Index ? "index" : "noindex")},{(Follow ? "follow" : "nofollow")}";
}
