<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <ErrorBoundary>
                <ChildContent>
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            <LayoutView Layout="@typeof(MainLayout)">
                                <ResultStatusView Status="ResultStatus.Forbidden"
                                                  Message="برای مشاهده این صفحه باید وارد حسابی شوید که Permission لازم را دارد." />
                            </LayoutView>
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </ChildContent>
                <ErrorContent Context="error">
                    <LayoutView Layout="@typeof(MainLayout)">
                        <ResultStatusView Error="@error" />
                    </LayoutView>
                </ErrorContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <ResultStatusView Status="ResultStatus.NotFound"
                                  Message="صفحه‌ای که درخواست کرده‌اید وجود ندارد یا آدرس آن تغییر کرده است." />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
